page en_examples at "/examples/":
    title "Examples and source — Sedrava"
    description "Official Sedrava documentation. Published language 0.10.0; this native website uses experimental 0.11."
    lang "en"
    use EnglishHeader
    container max 1320 padding 24:
        column gap 24:
            link "Русский" to "/ru/examples/"
            grid columns 2 class "doc-layout":
                use EnglishSidebar
                column gap 24 class "doc-body":
                    heading "Examples and source"
                    search label "Search documentation"
                    markdown "content/en/examples.md"
                    callout variant warning:
                        paragraph "The live examples below use experimental 0.11. The HTTP catalog uses a real controlled endpoint only in CI; static dev hosting reports an honest HTTP error until an endpoint is provided."
                    demo "demos/counter.sdr" at "/live/counter/" label "Counter · persistent state" id counter
                    demo "demos/calculator.sdr" at "/live/calculator/" label "Calculator · signed integer arithmetic" id calculator
                    paragraph "The calculator uses integer arithmetic: 7 ÷ 2 = 3 and −7 ÷ 2 = −3. Floating-point numbers are not yet available in Sedrava."
                    demo "demos/tasks.sdr" at "/live/tasks/" label "Tasks · CRUD and routes" id tasks
                    demo "demos/crm.sdr" at "/live/crm/" label "CRM · related records and themes" id crm
                    demo "demos/catalog.sdr" at "/live/catalog/" label "HTTP catalog · CI-only endpoint" id catalog
                    row justify between class "next-prev":
                        link "← CLI and builds" to "/cli/"
                        link "Release notes →" to "/release-notes/"
    use EnglishFooter

