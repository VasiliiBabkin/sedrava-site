site "Sedrava · native documentation"
origin "https://dev.virtreal.ru"
clean-urls true
robots false
stylesheet "assets/brand.css"
license "assets/INTER_LICENSE.txt"
license "assets/LICENSE_COMPILER.txt"
license "assets/LICENSE_SITE.txt"
favicon "assets/mark.svg"
social-image "assets/mark.svg"
import "components/chrome.sdr"
theme:
    background "#F5F0E8"
    surface "#FFFFFF"
    foreground "#231A35"
    accent "#583C82"
    gold "#8B6419"
    muted "#62596D"
    border "#D6CBDD"

page en_home at "/":
    title "This website is built with Sedrava — Sedrava"
    description "Official Sedrava documentation. Published language 0.10.0; this native website uses experimental 0.11."
    lang "en"
    use EnglishHeader
    container max 1320 padding 24:
        column gap 24:
            link "Русский" to "/ru/"
            column gap 24 class "hero":
                image "assets/mark.svg" alt "Sedrava folded amethyst ribbon with a gold cut" class "hero-image"
                paragraph "SEDRAVA · DESCRIBE → GENERATE" variant eyebrow
                heading "This website is built with Sedrava"
                paragraph "Describe the application. Generate the application. Typed data, rules and interface in one readable source." variant lead
                row:
                    button "Start building" to "/getting-started/"
                    button "Run live examples" to "/examples/" variant secondary
                    button "Open calculator" to "/live/calculator/" variant secondary
                paragraph "Published 0.10.0 · Experimental website compiler 0.11" class "brand-label"
            search label "Search documentation"
            grid columns 2 class "brand-grid":
                card:
                    column:
                        heading "A stateful counter" level 2
                        paragraph "The running application and its exact .sdr source on the same page."
                        link "Open example" to "/examples/#counter"
                card:
                    column:
                        heading "An offline task manager" level 2
                        paragraph "The running application and its exact .sdr source on the same page."
                        link "Open example" to "/examples/#tasks"
                card:
                    column:
                        heading "A related-record client desk" level 2
                        paragraph "The running application and its exact .sdr source on the same page."
                        link "Open example" to "/examples/#crm"
                card:
                    column:
                        heading "A typed HTTP catalog · CI endpoint" level 2
                        paragraph "The running application and its exact .sdr source on the same page."
                        link "Open example" to "/examples/#catalog"
            markdown "content/en/home.md"
    use EnglishFooter

page en_getting_started at "/getting-started/":
    title "Getting started — Sedrava"
    description "Official Sedrava documentation. Published language 0.10.0; this native website uses experimental 0.11."
    lang "en"
    use EnglishHeader
    container max 1320 padding 24:
        column gap 24:
            link "Русский" to "/ru/getting-started/"
            grid columns 2 class "doc-layout":
                use EnglishSidebar
                column gap 24 class "doc-body":
                    heading "Getting started"
                    search label "Search documentation"
                    markdown "content/en/getting-started.md"
                    row justify between class "next-prev":
                        link "← Home" to "/"
                        link "Language overview →" to "/language-overview/"
    use EnglishFooter

