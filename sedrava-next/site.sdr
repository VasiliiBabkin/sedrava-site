page ru_home at "/ru/":
    title "Этот сайт написан на Sedrava — Sedrava"
    description "Официальная документация Sedrava. Опубликована 0.10.0; возможности этого сайта — экспериментальная 0.11."
    lang "ru"
    use RussianHeader
    container max 1320 padding 24:
        column gap 24:
            link "English" to "/"
            column gap 24 class "hero":
                image "assets/mark.svg" alt "Знак Sedrava: аметистовая складка с золотым разрезом" class "hero-image"
                paragraph "SEDRAVA · DESCRIBE → GENERATE" variant eyebrow
                heading "Этот сайт написан на Sedrava"
                paragraph "Опиши приложение — получи приложение. Данные, правила и интерфейс в одном понятном исходнике." variant lead
                row:
                    button "Начать разработку" to "/ru/getting-started/"
                    button "Запустить примеры" to "/ru/examples/" variant secondary
                    button "Калькулятор" to "/live/calculator/" variant secondary
                paragraph "Опубликована 0.10.0 · Экспериментальный компилятор сайта 0.11" class "brand-label"
            search label "Поиск по документации"
            grid columns 2 class "brand-grid":
                card:
                    column:
                        heading "Счётчик с состоянием" level 2
                        paragraph "Настоящее приложение и точный .sdr-исходник на одной странице."
                        link "Открыть пример" to "/ru/examples/#counter"
                card:
                    column:
                        heading "Офлайн-менеджер задач" level 2
                        paragraph "Настоящее приложение и точный .sdr-исходник на одной странице."
                        link "Открыть пример" to "/ru/examples/#tasks"
                card:
                    column:
                        heading "Компании и контакты" level 2
                        paragraph "Настоящее приложение и точный .sdr-исходник на одной странице."
                        link "Открыть пример" to "/ru/examples/#crm"
                card:
                    column:
                        heading "HTTP-каталог · сервер CI" level 2
                        paragraph "Настоящее приложение и точный .sdr-исходник на одной странице."
                        link "Открыть пример" to "/ru/examples/#catalog"
            markdown "content/ru/home.md"
    use RussianFooter

