page ru_examples at "/ru/examples/":
    title "Примеры и исходники — Sedrava"
    description "Официальная документация Sedrava. Опубликована 0.10.0; возможности этого сайта — экспериментальная 0.11."
    lang "ru"
    use RussianHeader
    container max 1320 padding 24:
        column gap 24:
            link "English" to "/examples/"
            grid columns 2 class "doc-layout":
                use RussianSidebar
                column gap 24 class "doc-body":
                    heading "Примеры и исходники"
                    search label "Поиск по документации"
                    markdown "content/ru/examples.md"
                    callout variant warning:
                        paragraph "Примеры ниже используют экспериментальную 0.11. HTTP-каталог работает с настоящим сервером только в CI; на статическом dev-сайте честно показывает ошибку HTTP, пока endpoint не предоставлен."
                    demo "demos/counter.sdr" at "/live/counter/" label "Счётчик · сохранение состояния" id counter
                    demo "demos/calculator.sdr" at "/live/calculator/" label "Калькулятор · арифметика целых чисел" id calculator
                    paragraph "Калькулятор работает с целыми числами: 7 ÷ 2 = 3, −7 ÷ 2 = −3. Дробные числа в Sedrava пока не поддерживаются."
                    demo "demos/tasks.sdr" at "/live/tasks/" label "Задачи · CRUD и переходы" id tasks
                    demo "demos/crm.sdr" at "/live/crm/" label "CRM · связанные записи и темы" id crm
                    demo "demos/catalog.sdr" at "/live/catalog/" label "HTTP-каталог · endpoint только в CI" id catalog
                    row justify between class "next-prev":
                        link "← CLI и сборка" to "/ru/cli/"
                        link "Заметки о выпуске →" to "/ru/release-notes/"
    use RussianFooter

