# Calculator for Sedrava experimental WebApp 0.11.
# Signed int32 arithmetic. Division truncates toward zero; no floating point.
webapp "Sedrava · Калькулятор"
stylesheet "assets/calculator.css"
theme:
    background "#151323"
    surface "#262337"
    foreground "#F8F5FF"
    accent "#BA9BFF"
    gold "#F5C87B"
    muted "#B4ACCA"
    border "#4E4668"

fn step_div(a: int, b: int, q: int, bit: int, limit: int) -> int = q + bit if b <= limit and (q + bit) * b <= a else q
fn part_26(a: int, b: int) -> int = step_div(a, b, 0, 67108864, 1)
fn part_25(a: int, b: int) -> int = step_div(a, b, part_26(a, b), 33554432, 2)
fn part_24(a: int, b: int) -> int = step_div(a, b, part_25(a, b), 16777216, 5)
fn part_23(a: int, b: int) -> int = step_div(a, b, part_24(a, b), 8388608, 11)
fn part_22(a: int, b: int) -> int = step_div(a, b, part_23(a, b), 4194304, 23)
fn part_21(a: int, b: int) -> int = step_div(a, b, part_22(a, b), 2097152, 47)
fn part_20(a: int, b: int) -> int = step_div(a, b, part_21(a, b), 1048576, 95)
fn part_19(a: int, b: int) -> int = step_div(a, b, part_20(a, b), 524288, 190)
fn part_18(a: int, b: int) -> int = step_div(a, b, part_19(a, b), 262144, 381)
fn part_17(a: int, b: int) -> int = step_div(a, b, part_18(a, b), 131072, 762)
fn part_16(a: int, b: int) -> int = step_div(a, b, part_17(a, b), 65536, 1525)
fn part_15(a: int, b: int) -> int = step_div(a, b, part_16(a, b), 32768, 3051)
fn part_14(a: int, b: int) -> int = step_div(a, b, part_15(a, b), 16384, 6103)
fn part_13(a: int, b: int) -> int = step_div(a, b, part_14(a, b), 8192, 12207)
fn part_12(a: int, b: int) -> int = step_div(a, b, part_13(a, b), 4096, 24414)
fn part_11(a: int, b: int) -> int = step_div(a, b, part_12(a, b), 2048, 48828)
fn part_10(a: int, b: int) -> int = step_div(a, b, part_11(a, b), 1024, 97656)
fn part_9(a: int, b: int) -> int = step_div(a, b, part_10(a, b), 512, 195312)
fn part_8(a: int, b: int) -> int = step_div(a, b, part_9(a, b), 256, 390625)
fn part_7(a: int, b: int) -> int = step_div(a, b, part_8(a, b), 128, 781250)
fn part_6(a: int, b: int) -> int = step_div(a, b, part_7(a, b), 64, 1562500)
fn part_5(a: int, b: int) -> int = step_div(a, b, part_6(a, b), 32, 3125000)
fn part_4(a: int, b: int) -> int = step_div(a, b, part_5(a, b), 16, 6250000)
fn part_3(a: int, b: int) -> int = step_div(a, b, part_4(a, b), 8, 12500000)
fn part_2(a: int, b: int) -> int = step_div(a, b, part_3(a, b), 4, 25000000)
fn part_1(a: int, b: int) -> int = step_div(a, b, part_2(a, b), 2, 50000000)
fn part_0(a: int, b: int) -> int = step_div(a, b, part_1(a, b), 1, 100000000)
fn absolute(value: int) -> int = -value if value < 0 else value
fn quotient(a: int, b: int) -> int = -part_0(absolute(a), absolute(b)) if (a < 0 and b >= 0) or (a >= 0 and b < 0) else part_0(absolute(a), absolute(b))
fn calculate(a: int, b: int, op: text) -> int = a + b if op == "add" else a - b if op == "subtract" else a * b if op == "multiply" else quotient(a, b)

state current = 0
state saved = 0
state pending = "none"
state fresh = true
state error_div0 = false
derive has_operation = pending != "none"
derive show_add = pending == "add"
derive show_subtract = pending == "subtract"
derive show_multiply = pending == "multiply"
derive show_divide = pending == "divide"

rule current >= -100000000 and current <= 100000000
rule saved >= -100000000 and saved <= 100000000

action clear:
    current = 0
    saved = 0
    pending = "none"
    fresh = true
    error_div0 = false
action sign:
    current = -current
    fresh = false
    error_div0 = false
action digit_0:
    error_div0 = false
    if fresh:
        current = 0
        fresh = false
    else:
        if current >= 0 and current <= 999:
            current = current * 10 + 0
        else:
            if current < 0 and current >= -999:
                current = current * 10 - 0
action digit_1:
    error_div0 = false
    if fresh:
        current = 1
        fresh = false
    else:
        if current >= 0 and current <= 999:
            current = current * 10 + 1
        else:
            if current < 0 and current >= -999:
                current = current * 10 - 1
action digit_2:
    error_div0 = false
    if fresh:
        current = 2
        fresh = false
    else:
        if current >= 0 and current <= 999:
            current = current * 10 + 2
        else:
            if current < 0 and current >= -999:
                current = current * 10 - 2
action digit_3:
    error_div0 = false
    if fresh:
        current = 3
        fresh = false
    else:
        if current >= 0 and current <= 999:
            current = current * 10 + 3
        else:
            if current < 0 and current >= -999:
                current = current * 10 - 3
action digit_4:
    error_div0 = false
    if fresh:
        current = 4
        fresh = false
    else:
        if current >= 0 and current <= 999:
            current = current * 10 + 4
        else:
            if current < 0 and current >= -999:
                current = current * 10 - 4
action digit_5:
    error_div0 = false
    if fresh:
        current = 5
        fresh = false
    else:
        if current >= 0 and current <= 999:
            current = current * 10 + 5
        else:
            if current < 0 and current >= -999:
                current = current * 10 - 5
action digit_6:
    error_div0 = false
    if fresh:
        current = 6
        fresh = false
    else:
        if current >= 0 and current <= 999:
            current = current * 10 + 6
        else:
            if current < 0 and current >= -999:
                current = current * 10 - 6
action digit_7:
    error_div0 = false
    if fresh:
        current = 7
        fresh = false
    else:
        if current >= 0 and current <= 999:
            current = current * 10 + 7
        else:
            if current < 0 and current >= -999:
                current = current * 10 - 7
action digit_8:
    error_div0 = false
    if fresh:
        current = 8
        fresh = false
    else:
        if current >= 0 and current <= 999:
            current = current * 10 + 8
        else:
            if current < 0 and current >= -999:
                current = current * 10 - 8
action digit_9:
    error_div0 = false
    if fresh:
        current = 9
        fresh = false
    else:
        if current >= 0 and current <= 999:
            current = current * 10 + 9
        else:
            if current < 0 and current >= -999:
                current = current * 10 - 9
action choose_add:
    if has_operation and not fresh:
        if pending == "divide" and current == 0:
            error_div0 = true
        else:
            current = calculate(saved, current, pending)
            saved = current
    else:
        if not has_operation:
            saved = current
    if not error_div0:
        pending = "add"
        fresh = true
action choose_subtract:
    if has_operation and not fresh:
        if pending == "divide" and current == 0:
            error_div0 = true
        else:
            current = calculate(saved, current, pending)
            saved = current
    else:
        if not has_operation:
            saved = current
    if not error_div0:
        pending = "subtract"
        fresh = true
action choose_multiply:
    if has_operation and not fresh:
        if pending == "divide" and current == 0:
            error_div0 = true
        else:
            current = calculate(saved, current, pending)
            saved = current
    else:
        if not has_operation:
            saved = current
    if not error_div0:
        pending = "multiply"
        fresh = true
action choose_divide:
    if has_operation and not fresh:
        if pending == "divide" and current == 0:
            error_div0 = true
        else:
            current = calculate(saved, current, pending)
            saved = current
    else:
        if not has_operation:
            saved = current
    if not error_div0:
        pending = "divide"
        fresh = true
action equals:
    if has_operation and not fresh:
        if pending == "divide" and current == 0:
            error_div0 = true
        else:
            current = calculate(saved, current, pending)
            pending = "none"
            fresh = true
            error_div0 = false

view main:
    container max 510 padding 16 class "calc-shell":
        column gap 18:
            paragraph "SEDRAVA / WEBAPP 0.11" variant eyebrow
            heading "Калькулятор"
            paragraph "Четыре действия с целыми числами. Деление — без дробной части." variant muted
            card class "calc-screen":
                column gap 8:
                    row gap 10:
                        value saved label "В памяти"
                        when show_add:
                            paragraph "+" variant eyebrow
                        when show_subtract:
                            paragraph "−" variant eyebrow
                        when show_multiply:
                            paragraph "×" variant eyebrow
                        when show_divide:
                            paragraph "÷" variant eyebrow
                    value current label "Результат"
            when error_div0:
                callout variant warning:
                    paragraph "Делить на ноль нельзя. Введите другое число или нажмите C."
            grid columns 4 gap 10 class "calc-keys":
                button "C" action clear class "calc-key calc-clear"
                button "±" action sign class "calc-key calc-aux"
                button "÷" action choose_divide class "calc-key calc-op"
                button "×" action choose_multiply class "calc-key calc-op"
                button "7" action digit_7 class "calc-key"
                button "8" action digit_8 class "calc-key"
                button "9" action digit_9 class "calc-key"
                button "−" action choose_subtract class "calc-key calc-op"
                button "4" action digit_4 class "calc-key"
                button "5" action digit_5 class "calc-key"
                button "6" action digit_6 class "calc-key"
                button "+" action choose_add class "calc-key calc-op"
                button "1" action digit_1 class "calc-key"
                button "2" action digit_2 class "calc-key"
                button "3" action digit_3 class "calc-key calc-key-digit"
                button "0" action digit_0 class "calc-key"
                button "=" action equals class "calc-key calc-equals"
            paragraph "Ввод — до 4 цифр; результат — до ±100 000 000. При переполнении Sedrava отклоняет действие без изменения состояния." variant muted
            paragraph "Интерфейс, кнопки и вычисления определены в исходном файле .sdr. Без стороннего JavaScript." variant muted
